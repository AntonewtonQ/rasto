# Copiar para .env (o .env real nunca entra no repositório)
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=mudar-isto
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGHOST=localhost
PGPORT=5433
PGDATABASE=rasto
PGUSER=rasto
PGPASSWORD=rasto
SITE_URL=http://localhost:3000
EMAIL_HOST=              # ex.: smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=         # ex.: conta@gmail.com
EMAIL_HOST_PASSWORD=     # Gmail: palavra-passe de aplicação (myaccount.google.com/apppasswords)
DEFAULT_FROM_EMAIL=Rasto <nao-responder@localhost>   # com Gmail, tem de ser o próprio endereço
DOMINIO=localhost
# Testes ponta a ponta: guarda os e-mails em ficheiros nesta pasta em vez de os enviar
EMAIL_FICHEIROS=
